{
    "info": {
        "name": "SOPHIX BSS \u2014 Platform",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "_postman_id": "1abb2758-a597-4def-b70c-f0cd86905626",
        "description": "Auto-generated API collection for the Platform bundle. Regenerate with `php artisan sophix:postman:generate`."
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{access_token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "GET /api/user",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "X-Operator-Code",
                        "value": "{{operator_code}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/user",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "user"
                    ]
                }
            }
        }
    ]
}
