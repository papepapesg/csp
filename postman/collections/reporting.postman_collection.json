{
    "info": {
        "name": "SOPHIX BSS \u2014 Reporting",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "_postman_id": "0dd90db5-9fe9-48ac-bc25-c8f518a4ebfd",
        "description": "Auto-generated API collection for the Reporting bundle. Regenerate with `php artisan sophix:postman:generate`."
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{access_token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "GET /api/reports/dashboards/{code}",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "X-Operator-Code",
                        "value": "{{operator_code}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/reports/dashboards/{code}",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "reports",
                        "dashboards",
                        "{code}"
                    ]
                }
            }
        },
        {
            "name": "GET /api/reports/metrics",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "X-Operator-Code",
                        "value": "{{operator_code}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/reports/metrics",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "reports",
                        "metrics"
                    ]
                }
            }
        }
    ]
}
