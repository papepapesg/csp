{
    "info": {
        "name": "SOPHIX BSS \u2014 Foundation",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "_postman_id": "677c82d0-e92a-4b24-ac87-de43a87ee520",
        "description": "Auto-generated API collection for the Foundation bundle. Regenerate with `php artisan sophix:postman:generate`."
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{access_token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "GET /api/health",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "X-Operator-Code",
                        "value": "{{operator_code}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/health",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "health"
                    ]
                }
            }
        },
        {
            "name": "GET /api/platform/config",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "X-Operator-Code",
                        "value": "{{operator_code}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/platform/config",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "platform",
                        "config"
                    ]
                }
            }
        }
    ]
}
