                    },
                    {
                        "key": "X-Correlation-Id",
                        "value": "{{$guid}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/itops/services/{service}/restart",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "itops",
                        "services",
