APP_NAME=SOPHIX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (PostgreSQL is authoritative per FOUNDATION_DB) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sophix
DB_USERNAME=sophix
DB_PASSWORD=sophix

# --- Session / Cache / Queue (Redis acceleration per FOUNDATION_CACHE) ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Domain event bus (FOUNDATION_KAFKA). Drivers: outbox (DB+queue) | kafka ---
SOPHIX_EVENT_BUS=outbox
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_PREFIX=sophix

# --- Workflow engine (FOUNDATION_CAMUNDA). Drivers: native (queue) | camunda ---
SOPHIX_WORKFLOW_DRIVER=native
CAMUNDA_BASE_URL=http://camunda:8080/engine-rest

# --- Policy/rules engine (FOUNDATION_DROOLS). Drivers: native | drools ---
SOPHIX_RULES_DRIVER=native
DROOLS_BASE_URL=http://drools:8080/kie-server

# --- Default operator context (multi-operator per FE-APP-00) ---
SOPHIX_DEFAULT_OPERATOR=WIK
SOPHIX_DEFAULT_COUNTRY=KE
SOPHIX_DEFAULT_CURRENCY=KES
SOPHIX_DEFAULT_TIMEZONE=Africa/Nairobi

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@sophix.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
