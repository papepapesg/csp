                    },
                    {
                        "key": "X-Operator-Code",
                        "value": "{{operator_code}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/itops/services",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "itops",
                        "services"
                    ]
